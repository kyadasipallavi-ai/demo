<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modern Home Page</title>
    <style>
        /* Base Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            line-height: 1.6;
            color: #333;
            background-color: #f9f9f9;
        }

        /* Navigation Bar */
        header {
            background-color: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1200px;
            margin: 0 auto;
            padding: 1rem 2rem;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: bold;
            color: #2563eb;
            text-decoration: none;
        }

        .nav-links {
            display: flex;
            list-style: none;
        }

        .nav-links li {
            margin-left: 2rem;
        }

        .nav-links a {
            text-decoration: none;
            color: #4b5563;
            font-weight: 500;
            transition: color 0.3s;
        }

        .nav-links a:hover {
            color: #2563eb;
        }

        /* Hero Section */
        .hero {
            background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
            padding: 6rem 2rem;
            text-align: center;
        }

        .hero-content {
            max-width: 800px;
            margin: 0 auto;
        }

        .hero h1 {
            font-size: 3rem;
            color: #1e3a8a;
            margin-bottom: 1.5rem;
        }

        .hero p {
            font-size: 1.25rem;
            color: #4b5563;
            margin-bottom: 2rem;
        }

        .btn {
            display: inline-block;
            background-color: #2563eb;
            color: #fff;
            padding: 0.75rem 1.5rem;
            text-decoration: none;
            border-radius: 5px;
            font-weight: 600;
            transition: background-color 0.3s;
        }

        .btn:hover {
            background-color: #1d4ed8;
        }

        /* Features Section */
        .features {
            max-width: 1200px;
            margin: 4rem auto;
            padding: 0 2rem;
        }

        .features h2 {
            text-align: center;
            font-size: 2rem;
            color: #1e3a8a;
            margin-bottom: 3rem;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }

        .card {
            background-color: #fff;
            padding: 2.5rem;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            text-align: center;
            border: 1px solid #e5e7eb;
        }

        .card h3 {
            margin-bottom: 1rem;
            color: #1f2937;
        }

        .card p {
            color: #6b7280;
        }

        /* Footer */
        footer {
            background-color: #1f2937;
            color: #9ca3af;
            text-align: center;
            padding: 2rem;
            margin-top: 4rem;
        }

        /* Mobile Optimization */
        @media (max-width: 768px) {
            .hero h1 { font-size: 2.25rem; }
            .navbar { flex-direction: column; gap: 1rem; }
            .nav-links li { margin: 0 1rem; }
            .nav-links { padding-left: 0; }
        }
    </style>
</head>
<body>

    <!-- Header & Navigation -->
    <header>
        <nav class="navbar">
            <a href="#" class="logo">BrandName</a>
            <ul class="nav-links">
                <li><a href="#">Home</a></li>
                <li><a href="#">About</a></li>
                <li><a href="#">Services</a></li>
                <li><a href="#">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Main Content -->
    <main>
        <!-- Hero Section -->
        <section class="hero">
            <div class="hero-content">
                <h1>Welcome to Your New Website</h1>
                <p>A clean, modern, and fully responsive layout engineered to give your visitors an exceptional user experience across all digital screens.</p>
                <a href="#" class="btn">Get Started Today</a>
            </div>
        </section>

        <!-- Features / Services Section -->
        <section class="features">
            <h2>Our Core Features</h2>
            <div class="grid">
                <div class="card">
                    <h3>Responsive Design</h3>
                    <p>Optimized seamlessly for mobile phones, tablets, and desktop computers.</p>
                </div>
                <div class="card">
                    <h3>Modern Styling</h3>
                    <p>Clean typography and balanced spacing designed for readability.</p>
                </div>
                <div class="card">
                    <h3>Clean Code</h3>
                    <p>Easily customizable HTML5 and CSS3 structured for rapid deployment.</p>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 BrandName. All rights reserved.</p>
    </footer>

</body>
</html>
